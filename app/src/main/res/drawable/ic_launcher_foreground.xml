<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gradient fill under the line, like the stock-page sparkline. -->
    <path android:pathData="M16,66 L38,53 L54,59 L72,42 L92,33 L92,90 L16,90 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="33"
                android:endX="54" android:endY="90"
                android:startColor="#702ECC71"
                android:endColor="#002ECC71" />
        </aapt:attr>
    </path>

    <!-- Green line trending up, spanning wide left-to-right. -->
    <path
        android:strokeColor="#2ECC71"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M16,66 L38,53 L54,59 L72,42 L92,33" />

    <!-- End point at the top-right. -->
    <path
        android:fillColor="#2ECC71"
        android:pathData="M92,33 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
