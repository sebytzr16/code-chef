<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/single_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Data content -->
    <LinearLayout
        android:id="@+id/single_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top line: symbol + refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/single_symbol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AAPL"
                android:textColor="@color/widget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/single_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="@string/refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/single_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Apple Inc"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <!-- Price + change on the left, chart on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/single_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/single_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲ $0.00 (0.00%)"
                    android:textColor="@color/price_up"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/single_openclose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Open $0.00 · Prev $0.00"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:paddingTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/single_chart"
                android:layout_width="110dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:scaleType="fitXY" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty / not-configured state -->
    <TextView
        android:id="@+id/single_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/widget_single_tap_configure"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

</FrameLayout>
